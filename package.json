{
  "name": "backend-pi-iot",
  "version": "1.0.0",
  "description": "Backend do Projeto Integrador (4o modulo ADS) - monitoramento climatico para exportadoras de frutas (Petrolina/Juazeiro)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "seed:limpo": "node scripts/seed.js --sem-historico",
    "test": "jest --runInBand",
    "test:report": "jest --runInBand --json --outputFile=reports/test-results.json"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
